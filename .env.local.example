# Supabase (self-hosted в Coolify) — публичные параметры
# Берём из Environment Variables Supabase-сервиса в Coolify.

NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-domain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Опционально — service role для скриптов/миграций с локали
# (никогда не префикс NEXT_PUBLIC_, не коммитить).
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Опционально — для `supabase db push` напрямую в Postgres
# DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@supabase.your-domain.com:5432/postgres
