# Postgres
# Локально: docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
# Prod: URL из Coolify Postgres-сервиса.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moneta

# Better Auth
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Базовый URL приложения (для cookies, OAuth redirect, ссылок в письмах).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (email verification + password reset)
# https://resend.com/api-keys
RESEND_API_KEY=
# From-адрес. Должен быть на верифицированном в Resend домене.
EMAIL_FROM=moneta <noreply@your-domain.com>
